{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:somavera:soma:observation-preview-denial:provisional-v1",
  "title": "Soma observation preview denial provisional v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "denial_id", "created_at", "source_kind", "source_commitment", "policy_hash", "reason_codes", "secret_scan", "authority"],
  "properties": {
    "schema_version": { "const": "soma.observation-preview-denial.provisional-v1" },
    "denial_id": { "$ref": "#/$defs/hash" },
    "created_at": { "type": "string", "format": "date-time" },
    "source_kind": { "enum": ["artifact", "evidence"] },
    "source_commitment": { "$ref": "#/$defs/hash" },
    "policy_hash": { "$ref": "#/$defs/hash" },
    "reason_codes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "const": "SECRET_OR_PROHIBITED_IDENTITY_CANARY" } },
    "secret_scan": {
      "type": "object", "additionalProperties": false, "required": ["profile", "passed", "findings"],
      "properties": {
        "profile": { "const": "soma.high-confidence-secret-and-identity-canaries.provisional-v1" },
        "passed": { "const": false },
        "findings": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["code", "field", "utf16_offset"],
            "properties": {
              "code": { "enum": ["private_key_pem", "aws_access_key", "github_token", "openai_api_key", "slack_token", "jwt", "authorization_header", "credential_assignment", "credentialed_uri", "email_identity", "us_ssn", "phone_identity", "ethereum_address", "bitcoin_address", "recovery_phrase_label"] },
              "field": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
              "utf16_offset": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "authority": { "const": "denial_only_no_payload_no_grant_no_send" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
