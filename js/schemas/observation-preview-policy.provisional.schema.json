{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:somavera:soma:observation-preview-policy:provisional-v1",
  "title": "Soma observation preview policy provisional v1",
  "$comment": "Local preview only. This object grants no authority and cannot cause egress.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_kind",
    "data_class",
    "authorized_fields",
    "subject_did",
    "controller_did",
    "observer_did",
    "destination",
    "purposes",
    "operations",
    "data_state",
    "retention_seconds",
    "redistribution",
    "replication",
    "replication_targets",
    "model_training",
    "public_release",
    "license",
    "expires_at",
    "withdrawal_mode",
    "policy_version",
    "max_source_bytes",
    "artifact_metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "soma.observation-preview-policy.provisional-v1"
    },
    "source_kind": {
      "enum": [
        "artifact",
        "evidence"
      ]
    },
    "data_class": {
      "enum": [
        "public_artifact",
        "work_summary"
      ]
    },
    "authorized_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,63}$"
      }
    },
    "subject_did": {
      "$ref": "#/$defs/did"
    },
    "controller_did": {
      "$ref": "#/$defs/did"
    },
    "observer_did": {
      "$ref": "#/$defs/did"
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_did",
        "origin"
      ],
      "properties": {
        "host_did": {
          "$ref": "#/$defs/did"
        },
        "origin": {
          "type": "string",
          "pattern": "^https://(?![^/?#]*@)[^/?#]+$"
        }
      }
    },
    "purposes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "private_retrieval",
          "aggregate_research",
          "safety_evaluation",
          "model_training",
          "public_dataset",
          "dispute_resolution"
        ]
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "collect",
          "store_encrypted",
          "decrypt_in_attested_process",
          "derive",
          "evaluate",
          "train",
          "aggregate",
          "redistribute"
        ]
      }
    },
    "data_state": {
      "enum": [
        "host_confidential",
        "federated_training",
        "public_knowledge"
      ]
    },
    "retention_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 31536000
    },
    "redistribution": {
      "enum": [
        "none",
        "aggregate_only",
        "licensed_artifact"
      ]
    },
    "replication": {
      "enum": [
        "none",
        "named_hosts",
        "public"
      ]
    },
    "replication_targets": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "host_did",
          "origin"
        ],
        "properties": {
          "host_did": {
            "$ref": "#/$defs/did"
          },
          "origin": {
            "type": "string",
            "pattern": "^https://(?![^/?#]*@)[^/?#]+$"
          }
        }
      }
    },
    "model_training": {
      "type": "boolean"
    },
    "public_release": {
      "type": "boolean"
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "version"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "withdrawal_mode": {
      "enum": [
        "delete_deletable_and_tombstone",
        "stop_future_use_only"
      ]
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{2,63}$"
    },
    "max_source_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 262144
    },
    "artifact_metadata": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "media_type",
            "title",
            "source_uri",
            "rights_basis",
            "controller_attests_rights"
          ],
          "properties": {
            "media_type": {
              "enum": [
                "text/plain",
                "text/markdown",
                "application/json"
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "source_uri": {
              "type": "string",
              "pattern": "^https://"
            },
            "rights_basis": {
              "enum": [
                "owner_publication",
                "open_license",
                "public_domain",
                "documented_permission"
              ]
            },
            "controller_attests_rights": {
              "const": true
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "did": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^did:[a-z0-9]+:(?:[A-Za-z0-9._-]|%[0-9A-Fa-f]{2})+(?::(?:[A-Za-z0-9._-]|%[0-9A-Fa-f]{2})+)*$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_kind": {
            "const": "artifact"
          }
        },
        "required": [
          "source_kind"
        ]
      },
      "then": {
        "properties": {
          "data_class": {
            "const": "public_artifact"
          },
          "authorized_fields": {
            "items": {
              "enum": [
                "artifact_hash",
                "byte_length",
                "content_base64",
                "license_identifier",
                "license_version",
                "media_type",
                "source_uri",
                "title"
              ]
            }
          },
          "artifact_metadata": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_kind": {
            "const": "evidence"
          }
        },
        "required": [
          "source_kind"
        ]
      },
      "then": {
        "properties": {
          "data_class": {
            "const": "work_summary"
          },
          "authorized_fields": {
            "items": {
              "enum": [
                "artifact_hashes",
                "assurance",
                "capability",
                "claim_hash",
                "domain",
                "evidence_id",
                "kind",
                "occurred_at",
                "task_id"
              ]
            }
          },
          "artifact_metadata": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "data_state": {
            "const": "public_knowledge"
          }
        },
        "required": [
          "data_state"
        ]
      },
      "then": {
        "properties": {
          "license": {
            "oneOf": [
              {
                "const": {
                  "identifier": "Apache",
                  "version": "2.0"
                }
              },
              {
                "const": {
                  "identifier": "BSD-2-Clause",
                  "version": "N/A"
                }
              },
              {
                "const": {
                  "identifier": "BSD-3-Clause",
                  "version": "N/A"
                }
              },
              {
                "const": {
                  "identifier": "CC-BY",
                  "version": "4.0"
                }
              },
              {
                "const": {
                  "identifier": "CC-BY-SA",
                  "version": "4.0"
                }
              },
              {
                "const": {
                  "identifier": "CC0",
                  "version": "1.0"
                }
              },
              {
                "const": {
                  "identifier": "MIT",
                  "version": "N/A"
                }
              },
              {
                "const": {
                  "identifier": "ODC-BY",
                  "version": "1.0"
                }
              }
            ]
          }
        }
      }
    }
  ]
}
