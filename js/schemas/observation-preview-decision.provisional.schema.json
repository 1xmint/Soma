{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:somavera:soma:observation-preview-decision:provisional-v1",
  "title": "Soma approved observation preview decision provisional v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preview_id",
    "created_at",
    "source_kind",
    "source_id",
    "payload_hash",
    "payload_bytes",
    "policy_hash",
    "field_projection_hash",
    "data_class",
    "data_state",
    "authorized_fields",
    "redactions",
    "purposes",
    "operations",
    "destination",
    "retention_seconds",
    "redistribution",
    "replication",
    "replication_targets",
    "model_training",
    "public_release",
    "license",
    "expires_at",
    "withdrawal_mode",
    "policy_version",
    "secret_scan",
    "rights_check",
    "warnings",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "const": "soma.observation-preview-decision.provisional-v1"
    },
    "preview_id": {
      "$ref": "#/$defs/hash"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_kind": {
      "enum": [
        "artifact",
        "evidence"
      ]
    },
    "source_id": {
      "$ref": "#/$defs/hash"
    },
    "payload_hash": {
      "$ref": "#/$defs/hash"
    },
    "payload_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 400000
    },
    "policy_hash": {
      "$ref": "#/$defs/hash"
    },
    "field_projection_hash": {
      "$ref": "#/$defs/hash"
    },
    "data_class": {
      "enum": [
        "public_artifact",
        "work_summary"
      ]
    },
    "data_state": {
      "enum": [
        "host_confidential",
        "federated_training",
        "public_knowledge"
      ]
    },
    "authorized_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,63}$"
      }
    },
    "redactions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "reason"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "reason": {
            "const": "not_in_exact_authorized_projection"
          }
        }
      }
    },
    "purposes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "private_retrieval",
          "aggregate_research",
          "safety_evaluation",
          "model_training",
          "public_dataset",
          "dispute_resolution"
        ]
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "collect",
          "store_encrypted",
          "decrypt_in_attested_process",
          "derive",
          "evaluate",
          "train",
          "aggregate",
          "redistribute"
        ]
      }
    },
    "destination": {
      "$ref": "#/$defs/destination"
    },
    "retention_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 31536000
    },
    "redistribution": {
      "enum": [
        "none",
        "aggregate_only",
        "licensed_artifact"
      ]
    },
    "replication": {
      "enum": [
        "none",
        "named_hosts",
        "public"
      ]
    },
    "replication_targets": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/destination"
      }
    },
    "model_training": {
      "type": "boolean"
    },
    "public_release": {
      "type": "boolean"
    },
    "license": {
      "$ref": "#/$defs/license"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "withdrawal_mode": {
      "enum": [
        "delete_deletable_and_tombstone",
        "stop_future_use_only"
      ]
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{2,63}$"
    },
    "secret_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "passed",
        "findings"
      ],
      "properties": {
        "profile": {
          "const": "soma.high-confidence-secret-and-identity-canaries.provisional-v1"
        },
        "passed": {
          "const": true
        },
        "findings": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "rights_check": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "basis"
          ],
          "properties": {
            "result": {
              "const": "controller_attested_not_independently_verified"
            },
            "basis": {
              "enum": [
                "owner_publication",
                "open_license",
                "public_domain",
                "documented_permission"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result"
          ],
          "properties": {
            "result": {
              "const": "not_applicable_minimized_local_evidence"
            }
          }
        }
      ]
    },
    "warnings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "preview_only_no_grant_no_send",
          "destination_is_proposed_not_pinned_in_this_release",
          "scanner_is_defense_in_depth_and_cannot_prove_absence_of_private_or_regulated_meaning"
        ]
      }
    },
    "authority": {
      "const": "preview_only_no_grant_no_send"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "did": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^did:[a-z0-9]+:(?:[A-Za-z0-9._-]|%[0-9A-Fa-f]{2})+(?::(?:[A-Za-z0-9._-]|%[0-9A-Fa-f]{2})+)*$"
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_did",
        "origin"
      ],
      "properties": {
        "host_did": {
          "$ref": "#/$defs/did"
        },
        "origin": {
          "type": "string",
          "pattern": "^https://(?![^/?#]*@)[^/?#]+$"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "version"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "data_state": {
            "const": "public_knowledge"
          }
        },
        "required": [
          "data_state"
        ]
      },
      "then": {
        "properties": {
          "license": {
            "oneOf": [
              {
                "const": {
                  "identifier": "Apache",
                  "version": "2.0"
                }
              },
              {
                "const": {
                  "identifier": "BSD-2-Clause",
                  "version": "N/A"
                }
              },
              {
                "const": {
                  "identifier": "BSD-3-Clause",
                  "version": "N/A"
                }
              },
              {
                "const": {
                  "identifier": "CC-BY",
                  "version": "4.0"
                }
              },
              {
                "const": {
                  "identifier": "CC-BY-SA",
                  "version": "4.0"
                }
              },
              {
                "const": {
                  "identifier": "CC0",
                  "version": "1.0"
                }
              },
              {
                "const": {
                  "identifier": "MIT",
                  "version": "N/A"
                }
              },
              {
                "const": {
                  "identifier": "ODC-BY",
                  "version": "1.0"
                }
              }
            ]
          }
        }
      }
    }
  ]
}
