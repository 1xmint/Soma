{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:somavera:schema:checkpoint:v1",
  "title": "Somavera Finalized Checkpoint v1",
  "$comment": "checkpoint_id excludes itself, schema metadata, external anchors, and signatures; see ID-DERIVATION.md",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checkpoint_id",
    "network_lineage_id",
    "execution_context_id",
    "context_epoch",
    "height",
    "finalized_at",
    "block_hash",
    "app_hash",
    "public_state_root",
    "balances_root",
    "live_supply_grain",
    "lifetime_minted_grain",
    "lifetime_burned_grain",
    "validator_set_hash",
    "governance_state_hash",
    "governance_manifest_hash",
    "recovery_authority_manifest_hash",
    "key_history_hash",
    "protocol_release_hash",
    "origin_hash",
    "asset_lineage_id",
    "public_artifact_roots",
    "previous_checkpoint_id",
    "external_anchors",
    "finality_signatures"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "somavera.checkpoint.v1" },
    "checkpoint_id": { "$ref": "#/$defs/hash" },
    "network_lineage_id": {
      "type": "string",
      "pattern": "^somavera:network:v1:[a-f0-9]{64}$"
    },
    "execution_context_id": {
      "type": "string",
      "pattern": "^somavera:context:v1:[a-f0-9]{64}$"
    },
    "context_epoch": { "type": "integer", "minimum": 0 },
    "height": { "type": "integer", "minimum": 0 },
    "finalized_at": { "type": "string", "format": "date-time" },
    "block_hash": { "$ref": "#/$defs/hash" },
    "app_hash": { "$ref": "#/$defs/hash" },
    "public_state_root": { "$ref": "#/$defs/hash" },
    "balances_root": { "$ref": "#/$defs/hash" },
    "live_supply_grain": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "lifetime_minted_grain": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "lifetime_burned_grain": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "validator_set_hash": { "$ref": "#/$defs/hash" },
    "governance_state_hash": { "$ref": "#/$defs/hash" },
    "governance_manifest_hash": { "$ref": "#/$defs/hash" },
    "recovery_authority_manifest_hash": { "$ref": "#/$defs/hash" },
    "key_history_hash": { "$ref": "#/$defs/hash" },
    "protocol_release_hash": { "$ref": "#/$defs/hash" },
    "origin_hash": { "$ref": "#/$defs/hash" },
    "asset_lineage_id": {
      "oneOf": [
        { "type": "string", "pattern": "^vera:rpa:v1:[a-f0-9]{64}$" },
        { "type": "null" }
      ]
    },
    "public_artifact_roots": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/hash" }
    },
    "previous_checkpoint_id": {
      "oneOf": [
        { "$ref": "#/$defs/hash" },
        { "type": "null" }
      ]
    },
    "external_anchors": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uri", "reference", "anchored_at"],
        "properties": {
          "uri": { "type": "string", "minLength": 3, "maxLength": 512 },
          "reference": { "type": "string", "minLength": 1, "maxLength": 512 },
          "anchored_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "finality_signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/signature" }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validator_id", "suite", "key_id", "value"],
      "properties": {
        "validator_id": { "type": "string", "pattern": "^did:[a-z0-9]+:.+$" },
        "suite": { "const": "Ed25519-v1" },
        "key_id": { "type": "string", "minLength": 3, "maxLength": 512 },
        "value": {
          "type": "string",
          "contentEncoding": "base64",
          "minLength": 80,
          "maxLength": 128
        }
      }
    }
  }
}
