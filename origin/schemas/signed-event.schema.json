{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:somavera:schema:signed-event:v1",
  "title": "Somavera Signed Event Envelope v1",
  "$comment": "ID and signature projections are normative in ID-DERIVATION.md",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "network_lineage_id",
    "execution_context_id",
    "protocol",
    "action",
    "event_id",
    "actor_did",
    "audience",
    "nonce",
    "issued_at",
    "expires_at",
    "payload",
    "payload_hash",
    "signature"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "somavera.signed-event.v1" },
    "network_lineage_id": {
      "type": "string",
      "pattern": "^somavera:network:v1:[a-f0-9]{64}$"
    },
    "execution_context_id": {
      "type": "string",
      "pattern": "^somavera:context:v1:[a-f0-9]{64}$"
    },
    "protocol": {
      "type": "string",
      "enum": ["soma", "vera", "vera-ledger"]
    },
    "action": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,63}$"
    },
    "event_id": { "$ref": "#/$defs/hash" },
    "actor_did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:.+$"
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "nonce": {
      "type": "string",
      "pattern": "^[a-f0-9]{32,128}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "consent_grant_id": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite", "key_id", "value"],
      "properties": {
        "suite": {
          "type": "string",
          "enum": ["Ed25519-v1"]
        },
        "key_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512
        },
        "value": {
          "type": "string",
          "contentEncoding": "base64",
          "minLength": 80,
          "maxLength": 128
        }
      }
    }
  }
}

