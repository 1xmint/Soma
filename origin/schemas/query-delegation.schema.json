{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:somavera:schema:query-delegation:v1",
  "title": "Somavera Scoped Vera Query Delegation v1",
  "$comment": "Strict draft. A controller-signed, host-audienced authority credential; a DID label or parent string alone grants no query authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "delegation_id",
    "network_lineage_id",
    "execution_context_id",
    "controller_did",
    "delegate_soma_did",
    "audience_host_dids",
    "allowed_return_soma_dids",
    "query_constraints",
    "parent_delegation_id",
    "delegation_depth",
    "single_use",
    "nonce",
    "issued_at",
    "not_before",
    "expires_at",
    "revocation_registry_reference",
    "signing_key_id",
    "signature"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "somavera.query-delegation.v1" },
    "delegation_id": { "$ref": "#/$defs/hash" },
    "network_lineage_id": { "$ref": "#/$defs/network" },
    "execution_context_id": { "$ref": "#/$defs/context" },
    "controller_did": { "$ref": "#/$defs/did" },
    "delegate_soma_did": { "$ref": "#/$defs/did" },
    "audience_host_dids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/did" }
    },
    "allowed_return_soma_dids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/did" }
    },
    "query_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scopes", "purposes", "maximum_top_k", "artifact_statuses", "permitted_query_hashes"],
      "properties": {
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["public", "controller_confidential"] }
        },
        "purposes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["private_retrieval", "dispute_resolution"] }
        },
        "maximum_top_k": { "type": "integer", "minimum": 1, "maximum": 50 },
        "artifact_statuses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["reinforced", "provisional", "disputed", "withdrawn"] }
        },
        "permitted_query_hashes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "$comment": "An empty array means any query text satisfying the other limits; it never widens host/data authority.",
          "items": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "parent_delegation_id": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "delegation_depth": { "type": "integer", "minimum": 0, "maximum": 2 },
    "single_use": { "type": "boolean" },
    "nonce": { "type": "string", "pattern": "^[a-f0-9]{32,128}$" },
    "issued_at": { "type": "string", "format": "date-time" },
    "not_before": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "revocation_registry_reference": { "type": "string", "minLength": 3, "maxLength": 512 },
    "signing_key_id": { "$ref": "#/$defs/keyId" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "oneOf": [
    {
      "required": ["parent_delegation_id", "delegation_depth"],
      "properties": {
        "parent_delegation_id": { "type": "null" },
        "delegation_depth": { "const": 0 }
      }
    },
    {
      "required": ["parent_delegation_id", "delegation_depth"],
      "properties": {
        "parent_delegation_id": { "$ref": "#/$defs/hash" },
        "delegation_depth": { "type": "integer", "minimum": 1, "maximum": 2 }
      }
    }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "network": { "type": "string", "pattern": "^somavera:network:v1:[a-f0-9]{64}$" },
    "context": { "type": "string", "pattern": "^somavera:context:v1:[a-f0-9]{64}$" },
    "did": { "type": "string", "pattern": "^did:[a-z0-9]+:.+$", "maxLength": 512 },
    "keyId": { "type": "string", "minLength": 3, "maxLength": 512 },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite", "key_id", "value"],
      "properties": {
        "suite": { "const": "Ed25519-v1" },
        "key_id": { "$ref": "#/$defs/keyId" },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$",
          "minLength": 88,
          "maxLength": 88,
          "contentEncoding": "base64"
        }
      }
    }
  }
}
