{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:somavera:schema:vera-host-descriptor:v1",
  "title": "Somavera Vera Host Descriptor v1",
  "$comment": "Freeze-blocking draft. Identifier and signature projections are normative in ID-DERIVATION.md; placeholder examples are not trust anchors.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_status",
    "descriptor_id",
    "descriptor_sequence",
    "previous_descriptor_id",
    "rotation_policy",
    "network_lineage_id",
    "execution_context_id",
    "host_did",
    "origin",
    "discovery",
    "release",
    "policy_hash",
    "host_signing_keys",
    "ingestion_encryption_keys",
    "active_host_signing_key_id",
    "active_ingestion_key_id",
    "private_request_endpoint",
    "transport_security",
    "supported_protocols",
    "capabilities",
    "query_policy",
    "data_regions",
    "subprocessors",
    "retention_behavior",
    "model_use_disclosure",
    "capability_limits",
    "operator_memory_disclosure",
    "metadata_disclosure",
    "issued_at",
    "expires_at",
    "signature"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "somavera.vera-host-descriptor.v1" },
    "profile_status": { "const": "freeze_blocking_draft" },
    "descriptor_id": { "$ref": "#/$defs/hash" },
    "descriptor_sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "previous_descriptor_id": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/hash" }
      ]
    },
    "rotation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinary_succession",
        "successor_key_precommitment",
        "requires_prior_and_successor_signatures",
        "requires_controller_confirmation",
        "emergency_compromise_recovery",
        "maximum_overlap_seconds",
        "maximum_descriptor_lifetime_seconds",
        "allowed_change_scopes"
      ],
      "properties": {
        "ordinary_succession": { "const": "precommitted_overlap_dual_signature_v1" },
        "successor_key_precommitment": { "const": "required_in_prior_descriptor" },
        "requires_prior_and_successor_signatures": { "const": true },
        "requires_controller_confirmation": { "const": true },
        "emergency_compromise_recovery": { "const": "blocked_until_recovery_authority_profile" },
        "maximum_overlap_seconds": { "type": "integer", "minimum": 300, "maximum": 604800 },
        "maximum_descriptor_lifetime_seconds": { "type": "integer", "minimum": 900, "maximum": 31536000 },
        "allowed_change_scopes": {
          "const": [
            "renewal_only",
            "signing_key_rotation",
            "ingestion_key_rotation",
            "signing_and_ingestion_key_rotation"
          ]
        }
      }
    },
    "network_lineage_id": { "$ref": "#/$defs/network" },
    "execution_context_id": { "$ref": "#/$defs/context" },
    "host_did": { "$ref": "#/$defs/did" },
    "origin": {
      "type": "string",
      "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]{1,5})?$",
      "minLength": 12,
      "maxLength": 255
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "media_type", "redirects_allowed", "cache_max_age_seconds"],
      "properties": {
        "method": { "const": "GET" },
        "path": { "const": "/.well-known/somavera/vera-host.json" },
        "media_type": { "const": "application/json" },
        "redirects_allowed": { "const": false },
        "cache_max_age_seconds": { "type": "integer", "minimum": 0, "maximum": 3600 }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "release_manifest_hash", "origin_capsule_hash", "implementation"],
      "properties": {
        "release_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{2,63}$" },
        "release_manifest_hash": { "$ref": "#/$defs/hash" },
        "origin_capsule_hash": { "$ref": "#/$defs/hash" },
        "implementation": { "type": "string", "minLength": 3, "maxLength": 128 }
      }
    },
    "policy_hash": { "$ref": "#/$defs/hash" },
    "host_signing_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/signingKey" }
    },
    "ingestion_encryption_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/ingestionKey" }
    },
    "active_host_signing_key_id": { "$ref": "#/$defs/keyId" },
    "active_ingestion_key_id": { "$ref": "#/$defs/keyId" },
    "private_request_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "path",
        "media_type",
        "redirects_allowed",
        "maximum_encrypted_bytes",
        "maximum_plaintext_bytes",
        "hpke_profile",
        "hpke_profile_status"
      ],
      "properties": {
        "method": { "const": "POST" },
        "path": { "const": "/v1/private/requests" },
        "media_type": { "const": "application/json" },
        "redirects_allowed": { "const": false },
        "maximum_encrypted_bytes": { "type": "integer", "minimum": 1024, "maximum": 393216 },
        "maximum_plaintext_bytes": { "type": "integer", "minimum": 1, "maximum": 262144 },
        "hpke_profile": { "const": "HPKE-Base-X25519-HKDF-SHA256-AES256GCM-v1" },
        "hpke_profile_status": { "const": "freeze_blocking_draft" }
      }
    },
    "transport_security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tls_required", "minimum_tls_version", "server_name", "certificate_spki_sha256", "redirects_allowed"],
      "properties": {
        "tls_required": { "const": true },
        "minimum_tls_version": { "const": "1.3" },
        "server_name": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$", "minLength": 1, "maxLength": 253 },
        "certificate_spki_sha256": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/hash" }
        },
        "redirects_allowed": { "const": false }
      }
    },
    "supported_protocols": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "somavera-soma-vera-private-v1",
          "somavera-vera-public-query-v1",
          "somavera-vera-public-pack-v1",
          "somavera-vera-checkpoint-v1"
        ]
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["private_request_actions", "private_response_actions", "public_routes"],
      "properties": {
        "private_request_actions": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "enum": [
              "host.register",
              "host.challenge",
              "consent.register",
              "consent.withdraw",
              "contribution.offer",
              "vera.query",
              "export.request",
              "status.lookup",
              "content.delete",
              "tombstone.status"
            ]
          }
        },
        "private_response_actions": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "enum": [
              "host.registered",
              "host.challenge-result",
              "consent.accepted",
              "consent.withdrawn",
              "contribution.accepted",
              "contribution.rejected",
              "answer.source-bundle",
              "export.ready",
              "status.result",
              "content.deleted",
              "tombstone.result",
              "private.error"
            ]
          }
        },
        "public_routes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["host_descriptor", "public_query", "public_pack"] }
        }
      }
    },
    "query_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stores_private_query_bodies", "private_query_retention_seconds", "public_scope_enabled", "controller_confidential_scope_enabled", "requires_separate_training_consent", "maximum_top_k"],
      "properties": {
        "stores_private_query_bodies": { "type": "boolean" },
        "private_query_retention_seconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
        "public_scope_enabled": { "type": "boolean" },
        "controller_confidential_scope_enabled": { "type": "boolean" },
        "requires_separate_training_consent": { "const": true },
        "maximum_top_k": { "type": "integer", "minimum": 1, "maximum": 50 }
      }
    },
    "data_regions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["region_code", "jurisdiction"],
        "properties": {
          "region_code": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,31}$" },
          "jurisdiction": { "type": "string", "minLength": 2, "maxLength": 128 }
        }
      }
    },
    "subprocessors": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["processor_id", "purpose", "data_classes", "region_codes"],
        "properties": {
          "processor_id": { "type": "string", "minLength": 2, "maxLength": 128 },
          "purpose": { "type": "string", "minLength": 2, "maxLength": 256 },
          "data_classes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": { "enum": ["public_artifact", "work_summary", "objective_receipt"] }
          },
          "region_codes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,31}$" }
          }
        }
      }
    },
    "retention_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_host_confidential_seconds", "maximum_private_query_seconds", "maximum_backup_deletion_seconds", "withdrawal_blocks_future_use"],
      "properties": {
        "maximum_host_confidential_seconds": { "type": "integer", "minimum": 0, "maximum": 31536000 },
        "maximum_private_query_seconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
        "maximum_backup_deletion_seconds": { "type": "integer", "minimum": 0, "maximum": 2592000 },
        "withdrawal_blocks_future_use": { "const": true }
      }
    },
    "model_use_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inference_enabled", "training_enabled", "external_model_providers"],
      "properties": {
        "inference_enabled": { "const": false },
        "training_enabled": { "const": false },
        "external_model_providers": { "type": "array", "maxItems": 0 }
      }
    },
    "capability_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_query_utf8_bytes", "maximum_answer_plaintext_bytes", "maximum_contribution_plaintext_bytes", "maximum_concurrent_private_requests", "maximum_top_k"],
      "properties": {
        "maximum_query_utf8_bytes": { "type": "integer", "minimum": 1, "maximum": 262144 },
        "maximum_answer_plaintext_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "maximum_contribution_plaintext_bytes": { "type": "integer", "minimum": 1, "maximum": 262144 },
        "maximum_concurrent_private_requests": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "maximum_top_k": { "type": "integer", "minimum": 1, "maximum": 50 }
      }
    },
    "operator_memory_disclosure": {
      "type": "string",
      "enum": ["ordinary_process_operator_can_access_plaintext", "attested_profile_separately_required"]
    },
    "metadata_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ip_address", "timing", "approximate_size", "route_class"],
      "properties": {
        "ip_address": { "type": "boolean" },
        "timing": { "type": "boolean" },
        "approximate_size": { "type": "boolean" },
        "route_class": { "type": "boolean" }
      }
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "descriptor_sequence": { "const": 0 } },
        "required": ["descriptor_sequence"]
      },
      "then": { "properties": { "previous_descriptor_id": { "type": "null" } } }
    },
    {
      "if": {
        "properties": { "descriptor_sequence": { "type": "integer", "minimum": 1 } },
        "required": ["descriptor_sequence"]
      },
      "then": { "properties": { "previous_descriptor_id": { "$ref": "#/$defs/hash" } } }
    }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "network": { "type": "string", "pattern": "^somavera:network:v1:[a-f0-9]{64}$" },
    "context": { "type": "string", "pattern": "^somavera:context:v1:[a-f0-9]{64}$" },
    "did": { "type": "string", "pattern": "^did:[a-z0-9]+:.+$", "maxLength": 512 },
    "keyId": { "type": "string", "minLength": 3, "maxLength": 512 },
    "keyLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid_from", "valid_until", "status", "revoked_at", "revocation_reference"],
      "properties": {
        "valid_from": { "type": "string", "format": "date-time" },
        "valid_until": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "overlap", "retired", "revoked"] },
        "revoked_at": { "type": ["string", "null"], "format": "date-time" },
        "revocation_reference": { "type": ["string", "null"], "maxLength": 512 }
      }
    },
    "signingKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "purpose", "suite", "public_key_base64", "lifecycle"],
      "properties": {
        "key_id": { "$ref": "#/$defs/keyId" },
        "purpose": { "const": "descriptor_and_private_response_signing" },
        "suite": { "const": "Ed25519-v1" },
        "public_key_base64": { "$ref": "#/$defs/publicKey" },
        "lifecycle": { "$ref": "#/$defs/keyLifecycle" }
      }
    },
    "ingestionKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "purpose", "suite", "public_key_base64", "lifecycle"],
      "properties": {
        "key_id": { "$ref": "#/$defs/keyId" },
        "purpose": { "const": "private_request_decryption" },
        "suite": { "const": "HPKE-Base-X25519-HKDF-SHA256-AES256GCM-v1" },
        "public_key_base64": { "$ref": "#/$defs/publicKey" },
        "lifecycle": { "$ref": "#/$defs/keyLifecycle" }
      }
    },
    "publicKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{43}=$",
      "minLength": 44,
      "maxLength": 44,
      "contentEncoding": "base64"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite", "key_id", "value"],
      "properties": {
        "suite": { "const": "Ed25519-v1" },
        "key_id": { "$ref": "#/$defs/keyId" },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$",
          "minLength": 88,
          "maxLength": 88,
          "contentEncoding": "base64"
        }
      }
    }
  }
}
