    { "name": "substituted recovery manifest", "mutation": "substituted_recovery_manifest", "expected_codes": ["AUTHORITY_RECOVERY_MANIFEST_MISMATCH"] },
    { "name": "package and certificate authority substitution", "mutation": "joint_authority_substitution", "expected_codes": ["AUTHORITY_GOVERNANCE_MANIFEST_MISMATCH", "CERTIFICATE_PRESTATE_AUTHORITY_MISMATCH"] }
  ]
