{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:somavera:soma:evidence-head:provisional-v1",
  "title": "Soma evidence head provisional v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entry_count", "sequence", "entry_hash", "signer_key_id", "issued_at", "assurance", "anchors", "head_hash", "signature"],
  "properties": {
    "schema_version": { "const": "soma.evidence-head.provisional-v1" },
    "entry_count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "sequence": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
    "entry_hash": { "$ref": "#/$defs/hash" },
    "signer_key_id": { "type": "string", "minLength": 3 },
    "issued_at": { "type": "string", "format": "date-time" },
    "assurance": { "const": "local_only_unanchored" },
    "anchors": { "type": "array", "maxItems": 0 },
    "head_hash": { "$ref": "#/$defs/hash" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "signature": {
      "type": "object", "additionalProperties": false, "required": ["suite", "key_id", "value"],
      "properties": { "suite": { "const": "Ed25519-v1" }, "key_id": { "type": "string", "minLength": 3 }, "value": { "type": "string", "contentEncoding": "base64" } }
    }
  }
}
