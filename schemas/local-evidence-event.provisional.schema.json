{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:somavera:soma:local-evidence-event:provisional-v1",
  "title": "Soma local evidence event provisional v1",
  "$comment": "Signature proves local attribution and integrity, not truth, competence, independence, identity uniqueness, or reputation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "context_id", "kind", "subject_did", "issuer_did", "task_id", "capability", "domain", "claim_hash", "artifact_hashes", "receipt_ids", "occurred_at", "issued_at", "supersedes", "assurance", "evidence_id", "signature"],
  "properties": {
    "schema_version": { "const": "soma.local-evidence-event.provisional-v1" },
    "context_id": { "type": "string", "pattern": "^soma:local-context:v1:[a-f0-9]{64}$" },
    "kind": { "enum": ["assertion", "execution", "outcome", "dispute"] },
    "subject_did": { "$ref": "#/$defs/did" },
    "issuer_did": { "$ref": "#/$defs/did" },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "capability": { "$ref": "#/$defs/name" },
    "domain": { "$ref": "#/$defs/name" },
    "claim_hash": { "$ref": "#/$defs/hash" },
    "artifact_hashes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/hash" } },
    "receipt_ids": { "type": "array", "maxItems": 0 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "issued_at": { "type": "string", "format": "date-time" },
    "supersedes": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "assurance": { "const": "self_signed_attribution_only" },
    "evidence_id": { "$ref": "#/$defs/hash" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,127}$" },
    "did": { "type": "string", "pattern": "^did:[a-z0-9]+:.+$" },
    "signature": {
      "type": "object", "additionalProperties": false, "required": ["suite", "key_id", "value"],
      "properties": { "suite": { "const": "Ed25519-v1" }, "key_id": { "type": "string", "minLength": 3 }, "value": { "type": "string", "contentEncoding": "base64" } }
    }
  }
}
