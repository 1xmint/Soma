{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:somavera:soma:observation-payload:provisional-v1",
  "title": "Soma observation payload provisional v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_kind",
    "source_id",
    "data_class",
    "subject_did",
    "fields"
  ],
  "properties": {
    "schema_version": {
      "const": "soma.observation-payload.provisional-v1"
    },
    "source_kind": {
      "enum": [
        "artifact",
        "evidence"
      ]
    },
    "source_id": {
      "$ref": "#/$defs/hash"
    },
    "data_class": {
      "enum": [
        "public_artifact",
        "work_summary"
      ]
    },
    "subject_did": {
      "$ref": "#/$defs/did"
    },
    "fields": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "artifact_hash": {
              "$ref": "#/$defs/hash"
            },
            "byte_length": {
              "type": "integer",
              "minimum": 0,
              "maximum": 262144
            },
            "content_base64": {
              "type": "string",
              "contentEncoding": "base64"
            },
            "license_identifier": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "license_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "media_type": {
              "enum": [
                "text/plain",
                "text/markdown",
                "application/json"
              ]
            },
            "source_uri": {
              "type": "string",
              "pattern": "^https://"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "artifact_hashes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/hash"
              }
            },
            "assurance": {
              "const": "self_signed_attribution_only"
            },
            "capability": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
            },
            "claim_hash": {
              "$ref": "#/$defs/hash"
            },
            "domain": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
            },
            "evidence_id": {
              "$ref": "#/$defs/hash"
            },
            "kind": {
              "enum": [
                "assertion",
                "execution",
                "outcome",
                "dispute"
              ]
            },
            "occurred_at": {
              "type": "string",
              "format": "date-time"
            },
            "task_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_kind": {
            "const": "artifact"
          }
        }
      },
      "then": {
        "properties": {
          "data_class": {
            "const": "public_artifact"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_kind": {
            "const": "evidence"
          }
        }
      },
      "then": {
        "properties": {
          "data_class": {
            "const": "work_summary"
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "did": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^did:[a-z0-9]+:(?:[A-Za-z0-9._-]|%[0-9A-Fa-f]{2})+(?::(?:[A-Za-z0-9._-]|%[0-9A-Fa-f]{2})+)*$"
    }
  }
}
