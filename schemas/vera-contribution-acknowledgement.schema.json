{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:somavera:schema:vera-contribution-acknowledgement:v1",
  "title": "Somavera Vera Contribution Acknowledgement v1",
  "$comment": "Strict draft. The acknowledgement is signed only after the stated durable or non-mutating decision, then encrypted to the request-bound Soma return key.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "acknowledgement_id",
    "network_lineage_id",
    "execution_context_id",
    "protocol",
    "action",
    "host_did",
    "host_signing_key_id",
    "request_event_id",
    "contribution_event_id",
    "consent_grant_id",
    "recipient_ingestion_key_id",
    "soma_return_key_id",
    "return_descriptor_id",
    "received_stream_id",
    "received_envelope_ciphertext_root",
    "plaintext_payload_hash",
    "decision",
    "authoritative_mutation",
    "accepted_scope_or_null",
    "durable_object_ids",
    "host_sequence_or_null",
    "state_or_checkpoint_reference_or_null",
    "status_reference",
    "typed_reason_or_null",
    "issued_at",
    "signature"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "somavera.vera-contribution-acknowledgement.v1" },
    "acknowledgement_id": { "$ref": "#/$defs/hash" },
    "network_lineage_id": { "$ref": "#/$defs/network" },
    "execution_context_id": { "$ref": "#/$defs/context" },
    "protocol": { "const": "vera" },
    "action": { "type": "string", "enum": ["contribution.accepted", "contribution.rejected"] },
    "host_did": { "$ref": "#/$defs/did" },
    "host_signing_key_id": { "$ref": "#/$defs/keyId" },
    "request_event_id": { "$ref": "#/$defs/hash" },
    "contribution_event_id": { "$ref": "#/$defs/hash" },
    "consent_grant_id": { "$ref": "#/$defs/hash" },
    "recipient_ingestion_key_id": { "$ref": "#/$defs/keyId" },
    "soma_return_key_id": { "$ref": "#/$defs/keyId" },
    "return_descriptor_id": { "$ref": "#/$defs/hash" },
    "received_stream_id": { "$ref": "#/$defs/hash" },
    "received_envelope_ciphertext_root": { "$ref": "#/$defs/hash" },
    "plaintext_payload_hash": { "$ref": "#/$defs/hash" },
    "decision": { "type": "string", "enum": ["accepted", "accepted_narrowed", "rejected"] },
    "authoritative_mutation": { "type": "boolean" },
    "accepted_scope_or_null": {
      "oneOf": [
        { "$ref": "#/$defs/acceptedScope" },
        { "type": "null" }
      ]
    },
    "durable_object_ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/hash" }
    },
    "host_sequence_or_null": { "type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991 },
    "state_or_checkpoint_reference_or_null": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "status_reference": { "type": "string", "minLength": 3, "maxLength": 512 },
    "typed_reason_or_null": {
      "oneOf": [
        { "$ref": "#/$defs/reason" },
        { "type": "null" }
      ]
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "oneOf": [
    {
      "required": ["decision", "action", "authoritative_mutation", "accepted_scope_or_null", "durable_object_ids", "host_sequence_or_null", "state_or_checkpoint_reference_or_null", "typed_reason_or_null"],
      "properties": {
        "decision": { "enum": ["accepted", "accepted_narrowed"] },
        "action": { "const": "contribution.accepted" },
        "authoritative_mutation": { "const": true },
        "accepted_scope_or_null": { "$ref": "#/$defs/acceptedScope" },
        "durable_object_ids": { "type": "array", "minItems": 1 },
        "host_sequence_or_null": { "type": "integer", "minimum": 1 },
        "state_or_checkpoint_reference_or_null": { "$ref": "#/$defs/hash" },
        "typed_reason_or_null": { "type": "null" }
      }
    },
    {
      "required": ["decision", "action", "authoritative_mutation", "accepted_scope_or_null", "durable_object_ids", "host_sequence_or_null", "state_or_checkpoint_reference_or_null", "typed_reason_or_null"],
      "properties": {
        "decision": { "const": "rejected" },
        "action": { "const": "contribution.rejected" },
        "authoritative_mutation": { "const": false },
        "accepted_scope_or_null": { "type": "null" },
        "durable_object_ids": { "type": "array", "maxItems": 0 },
        "host_sequence_or_null": { "type": "null" },
        "state_or_checkpoint_reference_or_null": { "type": "null" },
        "typed_reason_or_null": { "$ref": "#/$defs/reason" }
      }
    }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "network": { "type": "string", "pattern": "^somavera:network:v1:[a-f0-9]{64}$" },
    "context": { "type": "string", "pattern": "^somavera:context:v1:[a-f0-9]{64}$" },
    "did": { "type": "string", "pattern": "^did:[a-z0-9]+:.+$", "maxLength": 512 },
    "keyId": { "type": "string", "minLength": 3, "maxLength": 512 },
    "acceptedScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_projection_hash",
        "data_class",
        "purposes",
        "operations",
        "data_state",
        "retention_deadline",
        "replication",
        "model_training",
        "public_release",
        "license"
      ],
      "properties": {
        "field_projection_hash": { "$ref": "#/$defs/hash" },
        "data_class": { "type": "string", "enum": ["public_artifact", "work_summary", "objective_receipt"] },
        "purposes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "enum": ["private_retrieval", "aggregate_research", "safety_evaluation", "model_training", "public_dataset", "dispute_resolution"] }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "enum": ["collect", "store_encrypted", "decrypt_in_attested_process", "derive", "evaluate", "train", "aggregate", "redistribute"] }
        },
        "data_state": { "type": "string", "enum": ["host_confidential", "federated_training", "public_knowledge"] },
        "retention_deadline": { "type": "string", "format": "date-time" },
        "replication": { "type": "string", "enum": ["none", "same_controller_hosts", "public_only"] },
        "model_training": { "type": "boolean" },
        "public_release": { "type": "boolean" },
        "license": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "public_detail"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "CONSENT_INVALID",
            "CONSENT_EXPIRED",
            "SCOPE_MISMATCH",
            "POLICY_REJECTED",
            "EVENT_REPLAY",
            "EVENT_EQUIVOCATION",
            "CONTENT_PROHIBITED",
            "SIZE_LIMIT",
            "STORAGE_UNAVAILABLE",
            "INDETERMINATE"
          ]
        },
        "public_detail": { "type": "string", "maxLength": 256 }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite", "key_id", "value"],
      "properties": {
        "suite": { "const": "Ed25519-v1" },
        "key_id": { "$ref": "#/$defs/keyId" },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$",
          "minLength": 88,
          "maxLength": 88,
          "contentEncoding": "base64"
        }
      }
    }
  }
}
