{
  "name": "somavera-reference",
  "version": "0.1.0",
  "private": true,
  "description": "Clean tokenless Somavera reference implementation",
  "type": "module",
  "bin": {
    "soma": "./bin/soma.mjs"
  },
  "scripts": {
    "manifest": "node scripts/build-release-manifest.mjs",
