{
  "name": "veraai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "vera-knowledge — provenance-bearing knowledge service for the Vera intelligence layer",
  "scripts": {
    "build": "tsc",
    "test": "node --test dist/**/*.test.js",
    "test:build": "tsc && node --test --test-concurrency=1 dist/tests/**/*.test.js",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^11.2.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.3.2",
    "postgres": "^3.4.5",
    "soma-heart": "^1.0.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "*",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.3",
    "typescript": "~5.7"
  }
}
